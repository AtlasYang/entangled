{
  "name": "entangled-monorepo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "tsc -b packages/*/tsconfig.json && tsc -p tsconfig.test.json && tsc -p registry/tsconfig.json && node scripts/check-readme.mjs && node scripts/check-devtools-bundle.mjs && node scripts/check-api-docs.mjs && node scripts/check-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry": "pnpm --filter @entangled-ui/registry build"
  },
  "devDependencies": {
    "@entangled-ui/devtools": "workspace:*",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jotai": "2.20.3",
    "jsdom": "26",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "zustand": "5.0.15"
  }
}
